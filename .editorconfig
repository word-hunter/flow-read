# EditorConfig keeps text files consistent across Windows and macOS.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown uses trailing spaces for explicit line breaks.
[*.md]
trim_trailing_whitespace = false

# Make recipes must be indented with tabs.
[Makefile]
indent_style = tab

# Windows command scripts conventionally require CRLF line endings.
[*.{bat,cmd}]
end_of_line = crlf

# Keep shell scripts executable and portable on Unix-like systems.
[*.sh]
end_of_line = lf

# Do not apply text-file rules to binary assets.
[*.{ico,png,jpg,jpeg,gif,webp,ttf,otf,zip,epub}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
